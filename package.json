{
  "name": "xue-sveltekit-blog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "velite build && node scripts/validate-content.mjs && vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync && velite",
    "lint": "eslint .",
    "test": "velite && vitest run",
    "test:e2e": "playwright test",
    "check:links": "node scripts/check-links.mjs",
    "check:deployment": "node scripts/check-deployment.mjs",
    "validate:content": "velite && node scripts/validate-content.mjs",
    "validate:generated": "git diff --exit-code -- static/site.webmanifest",
    "check": "npm run validate:content && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "velite && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "verify": "npm run lint && npm test && npm run check && npm run build && npm run check:links"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.1",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@types/node": "^22.20.1",
    "@velite/plugin-vite": "0.0.3",
    "eslint": "^10.8.0",
    "eslint-plugin-svelte": "^3.22.0",
    "exifr": "^7.1.3",
    "globals": "^17.8.0",
    "rehype-pretty-code": "^0.14.5",
    "rehype-slug": "^6.0.0",
    "sharp": "0.35.3",
    "shiki": "^4.3.1",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "velite": "0.4.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "wrangler": "4.114.0",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "@types/unist": "3.0.3",
    "@sveltejs/kit": {
      "cookie": "0.7.2"
    },
    "sharp": "0.35.3"
  }
}
