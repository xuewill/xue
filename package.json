{
  "name": "xue-sveltekit-blog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "npm run validate:content && vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "validate:content": "node scripts/validate-content.mjs",
    "check": "npm run validate:content && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "verify": "npm run lint && npm test && npm run check && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.61.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.69.3",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-svelte": "^3.22.0",
    "github-slugger": "^2.0.0",
    "globals": "^17.7.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-to-string": "^4.0.0",
    "mdsvex": "^0.12.7",
    "rehype-slug": "^6.0.0",
    "svelte": "^5.56.6",
    "svelte-check": "^4.7.3",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "wrangler": "4.113.0"
  },
  "overrides": {
    "@sveltejs/kit": {
      "cookie": "0.7.2"
    },
    "miniflare": {
      "sharp": "0.35.3"
    }
  }
}
