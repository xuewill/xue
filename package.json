{
  "name": "xue-sveltekit-blog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "npm run validate:content && vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync",
    "validate:content": "node scripts/validate-content.mjs",
    "check": "npm run validate:content && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.69.3",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "mdsvex": "^0.12.7",
    "svelte": "^5.56.6",
    "svelte-check": "^4.7.3",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "wrangler": "^4.111.0"
  }
}
